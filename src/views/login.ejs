<%- include('partials/header') %>

<div class="card" style="max-width: 400px; margin: 4rem auto;">
  <h2 class="text-center">Bem-vindo de volta</h2>
  
  <% if (erro) { %>
    <div class="alert"><%= erro %></div>
  <% } %>

  <form action="/login" method="POST">
    <div class="form-group">
      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" required placeholder="seu@email.com">
    </div>
    
    <div class="form-group">
      <label for="senha">Senha</label>
      <input type="password" id="senha" name="senha" required placeholder="••••••••">
    </div>

    <button type="submit" class="btn" style="width: 100%;">Entrar</button>
  </form>
  
  <p class="text-center mt-2" style="color: var(--text-muted); font-size: 0.9rem;">
    Ainda não tem conta? <a href="/cadastro" style="color: var(--primary);">Cadastre-se</a>
  </p>
</div>

<%- include('partials/footer') %>
