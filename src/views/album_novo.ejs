<%- include('partials/header') %>

<div class="card" style="max-width: 600px; margin: 2rem auto;">
  <h2>Criar Novo Álbum</h2>
  
  <% if (erro) { %>
    <div class="alert"><%= erro %></div>
  <% } %>

  <form action="/albuns/novo" method="POST">
    <div class="form-group">
      <label for="titulo">Título do Álbum</label>
      <input type="text" id="titulo" name="titulo" required placeholder="Ex: Viagem para a praia">
    </div>

    <div class="form-group">
      <label for="descricao">Descrição (Opcional)</label>
      <textarea id="descricao" name="descricao" rows="4" placeholder="Alguns detalhes sobre as fotos deste álbum..."></textarea>
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 1rem;">
      <a href="/" class="btn" style="background: transparent; border: 1px solid var(--border);">Cancelar</a>
      <button type="submit" class="btn">Salvar Álbum</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
